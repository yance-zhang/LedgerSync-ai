# Supabase project credentials. Use the publishable key in browser-safe contexts only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy anon-key name is also supported by the Supabase client helper.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
