# Dependencies and generated build output
node_modules/
.next/
out/
build/
coverage/
.vercel/
next-env.d.ts
*.tsbuildinfo

# Package manager lockfiles (dependency versions are recorded in package.json)
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb
bun.lock

# Local secrets and credentials; keep the safe template available
.env
.env.*
!.env.example
!.env.*.example
.supabase/

# Local logs, caches, and editor/OS metadata
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
.idea/
.vscode/

# Uploaded/source documents and other binary assets are not useful for code context
public/uploads/
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.heic
